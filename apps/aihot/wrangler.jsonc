{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "afreecoder-aihot",
	"account_id": "14adab5cba8297168cf0534d5da65db7",
	"routes": [{ "pattern": "aihot.afreecoder.dev", "custom_domain": true }],
	"main": "workers/app.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "build/client",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
	},
	"vars": {
		"SITE_URL": "https://aihot.afreecoder.dev",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "afreecoder-aihot",
			"database_id": "29966f27-64fe-45f1-a262-45759309db35",
			"migrations_dir": "migrations",
		},
	],
	"secrets": {
		"required": ["PUBLISH_TOKEN"],
	},
}
